{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/Downloads/my-Image.png",
    	"type": "sixel",
      	"height": 5,
      	"padding": {
            "top": 1,
    		"left": 2
      	}
    },
    "display": {
          "separator": " ➜  "
    },
    "modules": [
         {
            "type": "os",
            "key": "󰣨  ",
            "keyColor": "36",  // = color1
        },
        {
            "type": "kernel",
            "key": "  ",
            "keyColor": "36",
        },
        {
            "type": "wm",
            "key": "  ",
            "keyColor": "36",
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": "  ",
            "keyColor": "35",
        },
        {
            "type": "gpu",
            "format": "{1} {2}",
            "hideType": "integrated",
            "key": "󰢮  ",
            "keyColor": "35",
        },
        {
            "type": "memory",
            "key": "  ",
            "keyColor": "35",
        },
    ]
}
